# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1
GCP_LOCATION=asia-south1

# BigQuery
BIGQUERY_DATASET=govgrid
BIGQUERY_GRIEVANCES_TABLE=grievances
BIGQUERY_TENDERS_TABLE=tenders
BIGQUERY_CLUSTERS_TABLE=complaint_clusters

# Google Cloud Storage
GCS_BUCKET_NAME=govgrid-documents

# Vertex AI / Gemini
VERTEX_AI_MODEL=gemini-1.5-flash-002
VERTEX_AI_LOCATION=us-central1

# Google Maps Platform
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Application
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
DASHBOARD_PORT=8501

# Google Application Default Credentials
# Option 1: Service account key file path
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
# Option 2: Use `gcloud auth application-default login` for local dev
